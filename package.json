{
  "name": "claude-agent-context",
  "version": "0.2.0",
  "description": "Claude Agent SDK wrapper with mutable request context and generation callbacks",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./membrane": {
      "types": "./dist/membrane.d.ts",
      "import": "./dist/membrane.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@animalabs/membrane": ">=0.5.79 <0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@animalabs/membrane": "0.5.79"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "^0.93.0"
  },
  "peerDependenciesMeta": {
    "@animalabs/membrane": {
      "optional": true
    }
  }
}
